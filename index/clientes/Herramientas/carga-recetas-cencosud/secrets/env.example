# Copiar a .env en esta misma carpeta (secrets/.env). Nunca subir .env a Git.

# Login Business Manager (ADFS). Usar cuenta de trabajo con permiso de recetas.
CENCOSUD_BM_USER=
CENCOSUD_BM_PASSWORD=

# URL base
CENCOSUD_BM_URL=https://business-manager.ecomm.cencosud.com/

# Bandera destino (jumbo | santa-isabel | …) — ajustar tras mapear BM
CENCOSUD_BM_BANDERA=jumbo

# true = abrir navegador visible para depurar selectores
CENCOSUD_BM_HEADED=true

# true = no pulsar «Publicar»; solo rellenar / guardar borrador
CENCOSUD_BM_DRY_RUN=true
