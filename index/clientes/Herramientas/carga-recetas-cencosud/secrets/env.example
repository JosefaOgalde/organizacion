# Copiar a .env en esta misma carpeta (secrets/.env). Nunca subir .env a Git.
# En PowerShell (desde esta carpeta secrets):
#   Copy-Item env.example .env
# Luego edita .env con Bloc de notas.

# Login Business Manager (ADFS). Tu usuario de trabajo con permiso de recetas.
CENCOSUD_BM_USER=tu.usuario@empresa.cl
CENCOSUD_BM_PASSWORD=

# URL base
CENCOSUD_BM_URL=https://business-manager.ecomm.cencosud.com/

# URL del editor de la receta actual (copia desde la barra del navegador al mapear)
# CENCOSUD_BM_RECETA_URL=https://business-manager.ecomm.cencosud.com/.../view-manager/view/...

# Bandera destino (jumbo | santa-isabel | …)
CENCOSUD_BM_BANDERA=jumbo

# true = abrir navegador visible (obligatorio la primera vez / MFA)
CENCOSUD_BM_HEADED=true

# true = no pulsar «Publicar»; solo rellenar / guardar borrador
CENCOSUD_BM_DRY_RUN=true

# Selectores de login (opcional; si ADFS cambia, ajústalos tras inspeccionar)
# CENCOSUD_BM_LOGIN_USER_SEL=input[type="email"]
# CENCOSUD_BM_LOGIN_PASS_SEL=input[type="password"]
# CENCOSUD_BM_LOGIN_SUBMIT_SEL=button[type="submit"]
