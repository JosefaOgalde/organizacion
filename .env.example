# Copia a .env (no se sube a Git) y reinicia SERVIR.bat
PORT=3000
# 0.0.0.0 = accesible desde otros dispositivos en la misma WiFi
# (el celular NO puede usar localhost — ese es el propio teléfono)
HOST=0.0.0.0

# Token opcional para proteger GET/POST /api/organizacion
# Genera uno largo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORGANIZACION_TOKEN=

# Límite de tamaño del JSON al guardar (bytes). Por defecto 12 MB.
# MAX_BODY_BYTES=12582912

# --- Status diario Impresoreando (correo) ---
# Destinatarios fijos (Josefa + Nicolás). Separados por coma.
STATUS_TO=romerosilvanicolas@gmail.com,josefa.ogalde@gmail.com
# Cuenta Gmail que envía (con verificación en 2 pasos + contraseña de aplicación)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Impresoreando <tu@gmail.com>
# Probar sin enviar: DRY_RUN=1 node scripts/impresoreando-status-diario.js
# DRY_RUN=
