# Copia a .env (no se sube a Git) y reinicia SERVIR.bat
PORT=3000
HOST=127.0.0.1

# Clave de acceso — protege TODO el sitio (login en /login.html)
# Genera una con: CONFIGURAR-CLAVE.bat  o  node scripts/generar-clave-organizacion.js --mostrar
ORGANIZACION_ACCESS_KEY=

# Legacy: si no hay ACCESS_KEY, solo protege la API (sin pantalla de login)
# ORGANIZACION_TOKEN=

# Duración de sesión tras login (horas). Por defecto 24.
# ORGANIZACION_SESSION_HOURS=24

# Límite de tamaño del JSON al guardar (bytes). Por defecto 12 MB.
# MAX_BODY_BYTES=12582912
